__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# Bundled gemmi wheels are downloaded from PyPI by build_extension.py
# (running `download` regenerates both wheels/ and the manifest's wheels
# array), so they are not committed.
wheels/*.whl

# Test artifacts: logs written by tests/run_all.ps1, and gemmi unpacked out of
# wheels/ on the first test run.
tests/_logs/
tests/_gemmi/

# Local development material, kept on disk but not published: AI-agent
# configuration, scratch benchmarks/probes, superseded test groups and the
# separate cctbx add-on's tests.
.opencode/
opencode.json
tests/tools/
tests/external_cctbx/
tests/legacy_baked_polyhedra/
CIF/olex2/
cap.png

# Windows Explorer folder metadata
desktop.ini

# Built extension archives are attached to GitHub Releases, not committed.
dist/

# Cambridge Structural Database fixtures are not redistributable (their CIFs
# carry _database_code_CSD and the CCDC header).  They stay on the machine of
# whoever runs tests/test_chemdraw_sulfur.py; the committed chalcogen evidence
# is the COD-based tests/test_chemdraw_heterocycles.py.
CIF/S1.cif
CIF/S2.cif

# Local user structure used to debug the metal-coordinated sulfone depiction
# (a calcium sulfonate hydrate with S=O oxygens that also coordinate Ca/K).
# Not redistributable; stays on the author's machine like the S1/S2 CSD
# fixtures above.
CIF/Ca.cif

# Local user structures used to debug the sulfonate/triflate S=O depiction
# (ABEFUL: terbium tetrakis-sulfonatoporphyrin, ABOLIP: titanium triflate;
# CCDC 993277 / 1517523).  Not redistributable; stay on the author's machine
# like the CSD fixtures above.
CIF/test1.cif
CIF/test2.cif
